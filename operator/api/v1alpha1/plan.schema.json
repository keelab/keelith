{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelith.dev/schemas/topology/v1alpha1/plan.schema.json",
  "title": "Keelith topology plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "epoch",
    "placements",
    "components",
    "dependencies"
  ],
  "properties": {
    "apiVersion": {
      "const": "keelith.dev/topology/v1alpha1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "placement"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "placement": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "mode"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/identity"
          },
          "target": {
            "$ref": "#/$defs/identity"
          },
          "mode": {
            "enum": [
              "AUTO",
              "LOCAL",
              "REMOTE"
            ]
          }
        }
      }
    },
    "traffic": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epoch",
          "basisPoints"
        ],
        "properties": {
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "basisPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    }
  }
}
